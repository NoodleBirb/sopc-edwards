// Inspect: build/src/topc --psource --psym programs/iteration_forms.sop
// D2 front-end example; SOP type/ownership analysis and execution are deferred.
// Range loops, explicit and omitted steps, and an empty block.
// The binder i is an existing local, not a declaration made by the loop.
lower() { return 0; }
upper() { return 6; }

main() {
    var i, total, step;
    total = 0;
    step = 2;
    for (i : 0 .. 3) { total = total + i; }
    for (i : lower() .. upper() by step) { total = total + i; }
    for (i : 6 .. 0 by -1) { total = total + i; }
    for (i : 0 .. 0) {}
    return total;
}
