// Inspect: build/src/topc --psource --psym programs/slice_forms.sop
// D2 front-end example; SOP type/ownership analysis and execution are deferred.
// Each combination of omitted bounds, expression bounds, and chained slices.
main() {
    var values, middle, tail, head, whole, chained, count;
    values = [1, 2, 3, 4, 5];
    middle = values[1 + 1:4];
    tail = values[2:];
    head = values[:3];
    whole = values[:];
    chained = values[1:5][0:2];
    count = #(values[:#values]);
    return count;
}
