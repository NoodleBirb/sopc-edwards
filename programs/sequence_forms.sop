// Inspect: build/src/topc --psource --psym programs/sequence_forms.sop
// D2 front-end example; SOP type/ownership analysis and execution are deferred.
// Empty, singleton, and nested literals; expression elements; indexing; length.
main() {
    var empty, singleton, values, nested, first, cell, count;
    empty = [];
    singleton = [5 * 3];
    values = [1, 2 * 2, 3];
    nested = [[1, 2], [3, 4]];
    first = values[0];
    cell = nested[1][0];
    count = #values;
    return count;
}
