// Inspect: build/src/topc --psource --psym programs/lambda_forms.sop
// D2 front-end example; SOP type/ownership analysis and execution are deferred.
// One/multiple parameters, nested lambdas, captures, and general call syntax.
main() {
    var increment, add, makeAdder, addTwo, functions, result;
    increment = (x) => x + 1;
    add = (x, y) => increment(x) + y;
    makeAdder = (a) => (b) => a + b;
    addTwo = makeAdder(2);
    functions = [(n) => n + 1, (n) => n * 2];
    result = add(3, 4);
    result = addTwo(result);
    result = functions[0](result);
    result = ((z) => z + 1)(result);
    return result;
}
