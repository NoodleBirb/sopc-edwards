// Inspect: build/src/topc --psource --psym programs/combinations.sop
// D2 front-end example; SOP type/ownership analysis and execution are deferred.
// Sequence and borrowed iteration; a lambda inside a loop; nested constructs.
// A sequence element can be borrowed even though direct indexed assignment
// is rejected. Writing through the callee's borrowed parameter is distinct.
incrementCell(p) {
    *p = *p + 1;
    return 0;
}

main() {
    var values, nested, element, row, i, transform, total, ignored;
    values = [1, 2, 3, 4];
    nested = [[1, 2], [3, 4]];
    total = 0;
    for (element : values) { total = total + element; }
    for (element : values[1:] by 2) { total = total + element; }
    for (element : &values) {
        transform = (item) => item + 1;
        total = total + transform(element);
    }
    for (row : &nested) {
        for (i : 0 .. #row) { total = total + row[i]; }
    }
    ignored = incrementCell(&values[0]);
    return total;
}
