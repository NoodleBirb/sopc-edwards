// T16: R18, R21, R65
source(p) { if (*p != 0) error 1601; *p = 1; return [1, 2, 3]; }
lower(p) { if (*p != 1) error 1602; *p = 12; return 1; }
upper(p) { if (*p != 12) error 1603; *p = 123; return 3; }
main() {
 var trace, s; trace = 0;
 s = source(&trace)[lower(&trace):upper(&trace)];
 if (trace != 123) error 1604;
 if (#s != 2) error 1605;
 if (s[0] != 2) error 1606;
 if (s[1] != 3) error 1607;
 return 0;
}
