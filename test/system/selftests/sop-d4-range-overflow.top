// T21: R38, R39
main() {
 var i, n, max, min;
 max = 9223372036854775807; min = 0 - max - 1;
 n = 0;
 for (i : max - 1 .. max by 2) { n = n + 1; }
 if (n != 1) error 2101;
 if (i != max - 1) error 2102;
 n = 0;
 for (i : min + 1 .. min by -2) { n = n + 1; }
 if (n != 1) error 2103;
 if (i != min + 1) error 2104;
 n = 0;
 for (i : 1 .. max by max) { n = n + 1; }
 if (n != 1) error 2105;
 if (i != 1) error 2106;
 n = 0;
 for (i : -1 .. min by min) { n = n + 1; }
 if (n != 1) error 2107;
 if (i != -1) error 2108;
 return 0;
}
