// T38: R58, R63, R64, R65, R68
make() { return [4, 5, 6]; }
read(p) { return *p; }
main() {
 var s, u, value, n;
 s = [1, 2, 3];
 value = #make() + #(s[1:3]) + [7, 8, 9][0];
 if (value != 12) error 3801;
 u = [4, 5, 6][0:2];
 if (#u != 2) error 3802;
 if (u[1] != 5) error 3803;
 n = read(&make()[0]);
 if (n != 4) error 3804;
 return 0;
}
