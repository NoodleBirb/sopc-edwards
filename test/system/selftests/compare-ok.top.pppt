  p2 = alloc 7;
  if ((*p1 != *p2))
    error 5;
  if ((deq(&a, &b) != 1))
    error 6;
  if (((x == y) != 1))
    error 7;
  u = unset();
  v = unset();
  if (((u == v) != 1))
    error 8;
  return 0;
}

