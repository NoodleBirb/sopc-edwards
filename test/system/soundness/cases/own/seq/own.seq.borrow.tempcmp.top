// soundness grid case own.seq.borrow.tempcmp
// kind=own context=seq op1=borrow op2=tempcmp
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + look(&x);
  r = r + (make() == make());
  return 0;
}
