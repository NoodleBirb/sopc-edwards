// soundness grid case own.seq.ident.compare
// kind=own context=seq op1=ident op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  y = ident(x);
  r = r + (x == x);
  return 0;
}
