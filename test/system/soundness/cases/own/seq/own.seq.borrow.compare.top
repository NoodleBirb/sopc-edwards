// soundness grid case own.seq.borrow.compare
// kind=own context=seq op1=borrow op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + look(&x);
  r = r + (x == x);
  return 0;
}
