// soundness grid case own.seq.ident.tempcmp
// kind=own context=seq op1=ident op2=tempcmp
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  y = ident(x);
  r = r + (make() == make());
  return 0;
}
