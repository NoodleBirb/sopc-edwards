// soundness grid case own.call.tempcmp.compare
// kind=own context=call op1=tempcmp op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
pair(a1, a2) { return a1 + a2; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + pair((make() == make()), (x == x));
  return 0;
}
