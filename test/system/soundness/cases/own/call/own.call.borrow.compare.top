// soundness grid case own.call.borrow.compare
// kind=own context=call op1=borrow op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
pair(a1, a2) { return look(a1) + a2; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + pair(&x, (x == x));
  return 0;
}
