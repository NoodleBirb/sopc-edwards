// soundness grid case own.call.compare.temp
// kind=own context=call op1=compare op2=temp
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
pair(a1, a2) { return a1 + a2; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + pair((x == x), *make());
  return 0;
}
