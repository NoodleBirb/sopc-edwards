// soundness grid case own.if1.assign.compare
// kind=own context=if1 op1=assign op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { y = x; }
  r = r + (x == x);
  return 0;
}
