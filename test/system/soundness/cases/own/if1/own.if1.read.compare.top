// soundness grid case own.if1.read.compare
// kind=own context=if1 op1=read op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + *x; }
  r = r + (x == x);
  return 0;
}
