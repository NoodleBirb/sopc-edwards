// soundness grid case own.if1.temp.compare
// kind=own context=if1 op1=temp op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + *make(); }
  r = r + (x == x);
  return 0;
}
