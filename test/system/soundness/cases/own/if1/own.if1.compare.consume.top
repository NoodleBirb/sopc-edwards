// soundness grid case own.if1.compare.consume
// kind=own context=if1 op1=compare op2=consume
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + (x == x); }
  r = r + consume(x);
  return 0;
}
