// soundness grid case own.if1.compare.payload
// kind=own context=if1 op1=compare op2=payload
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + (x == x); }
  w = Wrap(x);
  return 0;
}
