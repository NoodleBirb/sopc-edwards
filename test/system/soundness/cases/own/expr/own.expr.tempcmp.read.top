// soundness grid case own.expr.tempcmp.read
// kind=own context=expr op1=tempcmp op2=read
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + (make() == make()) + *x;
  return 0;
}
