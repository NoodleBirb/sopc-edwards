// soundness grid case own.expr.compare.borrow
// kind=own context=expr op1=compare op2=borrow
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + (x == x) + look(&x);
  return 0;
}
