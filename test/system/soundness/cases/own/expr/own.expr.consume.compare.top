// soundness grid case own.expr.consume.compare
// kind=own context=expr op1=consume op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + consume(x) + (x == x);
  return 0;
}
