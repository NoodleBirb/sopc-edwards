// soundness grid case own.expr.temp.compare
// kind=own context=expr op1=temp op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  r = r + *make() + (x == x);
  return 0;
}
