// soundness grid case own.loop.tempcmp.borrow
// kind=own context=loop op1=tempcmp op2=borrow
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { return **q; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { r = r + (make() == make()); i = i - 1; }
  r = r + look(&x);
  return 0;
}
