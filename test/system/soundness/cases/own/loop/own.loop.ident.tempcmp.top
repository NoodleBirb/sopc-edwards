// soundness grid case own.loop.ident.tempcmp
// kind=own context=loop op1=ident op2=tempcmp
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { y = ident(x); i = i - 1; }
  r = r + (make() == make());
  return 0;
}
