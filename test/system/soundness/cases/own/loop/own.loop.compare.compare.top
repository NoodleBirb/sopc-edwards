// soundness grid case own.loop.compare.compare
// kind=own context=loop op1=compare op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 2;
  while (i > 0) { r = r + (x == x); i = i - 1; }
  r = r + (x == x);
  return 0;
}
