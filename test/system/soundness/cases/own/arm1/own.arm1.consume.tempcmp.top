// soundness grid case own.arm1.consume.tempcmp
// kind=own context=arm1 op1=consume op2=tempcmp
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + consume(x); } Off -> r = r + 0; }
  r = r + (make() == make());
  return 0;
}
