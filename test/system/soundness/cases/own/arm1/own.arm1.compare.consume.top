// soundness grid case own.arm1.compare.consume
// kind=own context=arm1 op1=compare op2=consume
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + (x == x); } Off -> r = r + 0; }
  r = r + consume(x);
  return 0;
}
