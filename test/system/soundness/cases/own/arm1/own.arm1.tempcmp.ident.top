// soundness grid case own.arm1.tempcmp.ident
// kind=own context=arm1 op1=tempcmp op2=ident
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + (make() == make()); } Off -> r = r + 0; }
  y = ident(x);
  return 0;
}
