// soundness grid case own.arm1.temp.compare
// kind=own context=arm1 op1=temp op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + *make(); } Off -> r = r + 0; }
  r = r + (x == x);
  return 0;
}
