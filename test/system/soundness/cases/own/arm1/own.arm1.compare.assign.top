// soundness grid case own.arm1.compare.assign
// kind=own context=arm1 op1=compare op2=assign
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  sel = On(1);
  case sel of { On(k) -> { r = r + (x == x); } Off -> r = r + 0; }
  y = x;
  return 0;
}
