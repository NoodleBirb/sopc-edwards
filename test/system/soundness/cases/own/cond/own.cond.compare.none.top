// soundness grid case own.cond.compare.none
// kind=own context=cond op1=compare op2=none
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  
  return 0;
}
