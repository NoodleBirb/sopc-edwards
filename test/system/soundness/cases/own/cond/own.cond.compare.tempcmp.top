// soundness grid case own.cond.compare.tempcmp
// kind=own context=cond op1=compare op2=tempcmp
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  r = r + (make() == make());
  return 0;
}
