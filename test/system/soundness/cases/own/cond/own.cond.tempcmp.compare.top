// soundness grid case own.cond.tempcmp.compare
// kind=own context=cond op1=tempcmp op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while ((make() == make()) > i) { i = i + 1000; }
  r = r + (x == x);
  return 0;
}
