// soundness grid case own.cond.compare.consume
// kind=own context=cond op1=compare op2=consume
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  r = r + consume(x);
  return 0;
}
