// soundness grid case own.if2.tempcmp.payload
// kind=own context=if2 op1=tempcmp op2=payload
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + (make() == make()); } else { r = r + (make() == make()); }
  w = Wrap(x);
  return 0;
}
