// soundness grid case own.if2.payload.compare
// kind=own context=if2 op1=payload op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { w = Wrap(x); } else { w = Wrap(x); }
  r = r + (x == x);
  return 0;
}
