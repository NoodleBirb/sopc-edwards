// soundness grid case own.if2.compare.read
// kind=own context=if2 op1=compare op2=read
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + (x == x); } else { r = r + (x == x); }
  r = r + *x;
  return 0;
}
