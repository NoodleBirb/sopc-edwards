// soundness grid case own.if2.compare.temp
// kind=own context=if2 op1=compare op2=temp
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
make() { var p; p = alloc 7; return p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + (x == x); } else { r = r + (x == x); }
  r = r + *make();
  return 0;
}
