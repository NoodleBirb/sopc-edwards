// soundness grid case own.if2.consume.compare
// kind=own context=if2 op1=consume op2=compare
// expect: reject (compares their addresses)
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { return *p; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = alloc 5;
  if (c > 0) { r = r + consume(x); } else { r = r + consume(x); }
  r = r + (x == x);
  return 0;
}
