// soundness grid case sum.call.compare.consumew
// kind=sum context=call op1=compare op2=consumew
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consumew(p) { var t; t = 0; case p of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
pair(a1, a2) { return a1 + consumew(a2); }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  r = r + pair((x == x), x);
  return 0;
}
