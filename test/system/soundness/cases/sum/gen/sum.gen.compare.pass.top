// soundness grid case sum.gen.compare.pass
// kind=sum context=gen op1=compare op2=pass
// expect: reject (compares it with)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
gen(f, g, z) { var t; t = 0; t = t + (z == z); t = t + f(z); return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  r = r + gen(consume, consume, x);
  return 0;
}
