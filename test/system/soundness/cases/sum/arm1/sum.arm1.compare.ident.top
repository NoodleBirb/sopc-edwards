// soundness grid case sum.arm1.compare.ident
// kind=sum context=arm1 op1=compare op2=ident
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { r = r + (x == x); } Off -> r = r + 0; }
  y = ident(x);
  return 0;
}
