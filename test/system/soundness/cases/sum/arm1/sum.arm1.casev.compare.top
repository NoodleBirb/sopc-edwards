// soundness grid case sum.arm1.casev.compare
// kind=sum context=arm1 op1=casev op2=compare
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } } Off -> r = r + 0; }
  r = r + (x == x);
  return 0;
}
