// soundness grid case sum.arm1.compare.none
// kind=sum context=arm1 op1=compare op2=none
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  sel = On(1);
  case sel of { On(k) -> { r = r + (x == x); } Off -> r = r + 0; }
  
  return 0;
}
