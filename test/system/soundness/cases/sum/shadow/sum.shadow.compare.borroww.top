// soundness grid case sum.shadow.compare.borroww
// kind=sum context=shadow op1=compare op2=borroww
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Val(_) -> t = 1; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  y = Val(9);
  case y of { Val(n) -> { r = r + (x == x); r = r + lookw(&x); r = r + n; } Nope -> { r = r + (x == x); r = r + lookw(&x); } }
  return 0;
}
