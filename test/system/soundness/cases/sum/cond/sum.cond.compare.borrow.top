// soundness grid case sum.cond.compare.borrow
// kind=sum context=cond op1=compare op2=borrow
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  r = r + look(&x);
  return 0;
}
