// soundness grid case sum.cond.compare.casev
// kind=sum context=cond op1=compare op2=casev
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  case x of { Val(n) -> r = r + n; Nope -> r = r + 0; }
  return 0;
}
