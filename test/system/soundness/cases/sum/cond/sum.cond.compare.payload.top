// soundness grid case sum.cond.compare.payload
// kind=sum context=cond op1=compare op2=payload
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  w = Wrap(x);
  return 0;
}
