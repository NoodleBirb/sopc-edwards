// soundness grid case sum.cond.compare.ident
// kind=sum context=cond op1=compare op2=ident
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  y = ident(x);
  return 0;
}
