// soundness grid case sum.if2.casev.compare
// kind=sum context=if2 op1=casev op2=compare
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } } else { case x of { Val(n) -> r = r + n; Nope -> r = r + 0; } }
  r = r + (x == x);
  return 0;
}
