// soundness grid case sum.if2.ident.compare
// kind=sum context=if2 op1=ident op2=compare
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { y = ident(x); } else { y = ident(x); }
  r = r + (x == x);
  return 0;
}
