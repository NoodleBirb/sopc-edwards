// soundness grid case sum.if2.compare.borrow
// kind=sum context=if2 op1=compare op2=borrow
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + (x == x); } else { r = r + (x == x); }
  r = r + look(&x);
  return 0;
}
