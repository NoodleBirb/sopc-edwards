// soundness grid case sum.if2.compare.none
// kind=sum context=if2 op1=compare op2=none
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + (x == x); } else { r = r + (x == x); }
  
  return 0;
}
