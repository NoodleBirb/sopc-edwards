// soundness grid case sum.if1.compare.payload
// kind=sum context=if1 op1=compare op2=payload
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  if (c > 0) { r = r + (x == x); }
  w = Wrap(x);
  return 0;
}
