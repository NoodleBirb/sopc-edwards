// soundness grid case sum.loop.compare.consume
// kind=sum context=loop op1=compare op2=consume
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 2;
  while (i > 0) { r = r + (x == x); i = i - 1; }
  r = r + consume(x);
  return 0;
}
