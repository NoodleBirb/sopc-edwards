// soundness grid case sum.loop.compare.ident
// kind=sum context=loop op1=compare op2=ident
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  i = 2;
  while (i > 0) { r = r + (x == x); i = i - 1; }
  y = ident(x);
  return 0;
}
