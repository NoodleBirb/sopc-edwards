// soundness grid case sum.seq.consume.compare
// kind=sum context=seq op1=consume op2=compare
// expect: reject (compares their addresses)
type Cell = Val(n) | Nope;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Val(n) -> t = n; Nope -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Val(5);
  r = r + consume(x);
  r = r + (x == x);
  return 0;
}
