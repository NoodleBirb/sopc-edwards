// soundness grid case sumown.if1.compare.casev
// kind=sumown context=if1 op1=compare op2=casev
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { r = r + (x == x); }
  case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; }
  return 0;
}
