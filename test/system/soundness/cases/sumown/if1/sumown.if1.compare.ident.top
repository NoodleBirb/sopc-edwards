// soundness grid case sumown.if1.compare.ident
// kind=sumown context=if1 op1=compare op2=ident
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
ident(z) { return z; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { r = r + (x == x); }
  y = ident(x);
  return 0;
}
