// soundness grid case sumown.loop.assign.compare
// kind=sumown context=loop op1=assign op2=compare
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { y = x; i = i - 1; }
  r = r + (x == x);
  return 0;
}
