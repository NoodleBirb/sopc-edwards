// soundness grid case sumown.loop.payload.compare
// kind=sumown context=loop op1=payload op2=compare
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { w = Wrap(x); i = i - 1; }
  r = r + (x == x);
  return 0;
}
