// soundness grid case sumown.loop.borroww.compare
// kind=sumown context=loop op1=borroww op2=compare
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 2;
  while (i > 0) { r = r + lookw(&x); i = i - 1; }
  r = r + (x == x);
  return 0;
}
