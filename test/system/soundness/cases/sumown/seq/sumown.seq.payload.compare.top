// soundness grid case sumown.seq.payload.compare
// kind=sumown context=seq op1=payload op2=compare
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  w = Wrap(x);
  r = r + (x == x);
  return 0;
}
