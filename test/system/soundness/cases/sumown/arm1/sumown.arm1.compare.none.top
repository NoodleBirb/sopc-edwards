// soundness grid case sumown.arm1.compare.none
// kind=sumown context=arm1 op1=compare op2=none
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  sel = On(1);
  case sel of { On(k) -> { r = r + (x == x); } Off -> r = r + 0; }
  
  return 0;
}
