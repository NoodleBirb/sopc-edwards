// soundness grid case sumown.call.compare.consume
// kind=sumown context=call op1=compare op2=consume
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
pair(a1, a2) { return a1 + consume(a2); }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  r = r + pair((x == x), x);
  return 0;
}
