// soundness grid case sumown.shadow.casev.compare
// kind=sumown context=shadow op1=casev op2=compare
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  y = Full(alloc 9);
  case y of { Full(v) -> { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } r = r + (x == x); r = r + *v; } Empty -> { case x of { Full(v) -> r = r + *v; Empty -> r = r + 0; } r = r + (x == x); } }
  return 0;
}
