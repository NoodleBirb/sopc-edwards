// soundness grid case sumown.shadow.compare.payload
// kind=sumown context=shadow op1=compare op2=payload
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  y = Full(alloc 9);
  case y of { Full(v) -> { r = r + (x == x); w = Wrap(x); r = r + *v; } Empty -> { r = r + (x == x); w = Wrap(x); } }
  return 0;
}
