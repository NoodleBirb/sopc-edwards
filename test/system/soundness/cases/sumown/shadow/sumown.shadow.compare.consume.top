// soundness grid case sumown.shadow.compare.consume
// kind=sumown context=shadow op1=compare op2=consume
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  y = Full(alloc 9);
  case y of { Full(v) -> { r = r + (x == x); r = r + consume(x); r = r + *v; } Empty -> { r = r + (x == x); r = r + consume(x); } }
  return 0;
}
