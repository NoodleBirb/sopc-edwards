// soundness grid case sumown.if2.compare.none
// kind=sumown context=if2 op1=compare op2=none
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  if (c > 0) { r = r + (x == x); } else { r = r + (x == x); }
  
  return 0;
}
