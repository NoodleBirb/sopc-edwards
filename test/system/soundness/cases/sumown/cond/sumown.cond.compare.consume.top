// soundness grid case sumown.cond.compare.consume
// kind=sumown context=cond op1=compare op2=consume
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
consume(p) { var t; t = 0; case p of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  r = r + consume(x);
  return 0;
}
