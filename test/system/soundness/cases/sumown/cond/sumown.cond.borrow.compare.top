// soundness grid case sumown.cond.borrow.compare
// kind=sumown context=cond op1=borrow op2=compare
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
look(q) { var t; t = 0; case *q of { Full(v) -> t = *v; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 0;
  while (look(&x) > i) { i = i + 1000; }
  r = r + (x == x);
  return 0;
}
