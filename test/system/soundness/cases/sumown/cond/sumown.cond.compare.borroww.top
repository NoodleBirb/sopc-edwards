// soundness grid case sumown.cond.compare.borroww
// kind=sumown context=cond op1=compare op2=borroww
// expect: reject (compares their addresses)
type Box = Full(v) | Empty;
type Wrapper = Wrap(inner);
type Sel = On(k) | Off;
lookw(q) { var t; t = 0; case *q of { Full(_) -> t = 1; Empty -> t = 0; } return t; }
main(c) {
  var x, y, w, r, i, sel;
  r = 0;
  x = Full(alloc 5);
  i = 0;
  while ((x == x) > i) { i = i + 1000; }
  r = r + lookw(&x);
  return 0;
}
